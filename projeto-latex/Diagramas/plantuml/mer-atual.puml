@startuml
!include tema.puml
hide circle
entity "Registro de auditoria" as R {
 Identificador do evento
 Tipo, entidade, ator e origem
 Instante de ocorrência
 Conteúdo contextual
 Hash do conteúdo completo
 Instante de inserção
}
note right of R
  Núcleo existente: uma entidade.
  Hash é atributo, não entidade separada.
end note
@enduml
