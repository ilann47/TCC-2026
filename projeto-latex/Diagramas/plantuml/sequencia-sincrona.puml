@startuml
!include tema.puml
actor Cliente
participant "API síncrona" as A
participant "Repositório comum" as R
database PostgreSQL as D
Cliente -> A : POST /audit
A -> A : validar contrato
A -> R : persist_event
R -> R : serialização + hash
R -> D : INSERT ON CONFLICT DO NOTHING
alt nova linha
 D --> R : linha inserida
else UUID existente
 R -> D : SELECT por UUID
 D --> R : hash armazenado
 R -> R : comparar; conflito gera rollback
end
R -> D : commit se inserção ou duplicata idêntica
D --> R : confirmação
R -> R : registrar commit_completed
R --> A : AuditStored
A --> Cliente : 201 persisted / duplicate
note over A,D
 Conflito: 409, preservando a linha.
 Banco indisponível: 503; resultado pode ser incerto.
end note
@enduml
