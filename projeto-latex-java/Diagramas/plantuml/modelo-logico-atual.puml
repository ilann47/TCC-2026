@startuml
!include tema.puml
hide circle
entity "audit_records\nESQUEMA IMPLEMENTADO" as A {
  * event_id : UUID <<PK>>
  --
  event_type : VARCHAR(100) <<NOT NULL>>
  entity_type : VARCHAR(100) <<NOT NULL>>
  entity_id : VARCHAR(200) <<NOT NULL; INDEX>>
  actor_id : VARCHAR(200) <<NOT NULL>>
  source : VARCHAR(100) <<NOT NULL>>
  occurred_at : TIMESTAMPTZ <<NOT NULL>>
  payload : JSONB <<NOT NULL>>
  content_hash : TEXT <<NOT NULL>>
  persisted_at : TIMESTAMPTZ <<NULL; DEFAULT clock_timestamp()>>
}
note right of A
  Uma tabela; nenhuma FK.
  Unicidade por event_id.
  A migração Flyway V1 permite NULL em persisted_at.
end note
@enduml
