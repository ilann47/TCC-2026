@startuml
!include tema.puml
start
:Receber mensagem do Kafka;
:Validar JSON, UUID explícito,\ninstante explícito e contrato;
if (Entrada válida?) then (sim)
 :Persistir com tentativas limitadas;\nRegistrar retry e aplicar backoff;
 if (Persistido ou duplicata idêntica?) then (sim)
  :Registrar conclusão pós-commit;
 else (não)
  :Encaminhar conflito ou tentativas\nesgotadas para a DLQ; <<procedure>>
 endif
else (não)
 :Encaminhar entrada inválida\npara a DLQ; <<procedure>>
endif
if (Persistência ou ACK da DLQ confirmado?) then (sim)
 :Confirmar offset de origem;
 if (Commit do offset confirmado?) then (sim)
  :Continuar aguardando mensagens;
 else (não)
  :Retomar sessão sem avançar\na origem não resolvida;
 endif
else (não)
 :Retomar sessão sem confirmar origem;
endif
note right
 Cada término representa uma iteração.
 O serviço mantém o laço de espera
 ou de reconexão.
end note
stop
@enduml
